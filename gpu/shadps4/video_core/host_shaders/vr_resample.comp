// VR, true stereo: an eye's picture for the headset at the runtime's own angles and pixels per degree, from the eye's
// scene (drawn wider, with a symmetric field of view, at the launcher's size). The runtime then shows it pixel for
// pixel instead of stretching a cropped part of it with its own filter. Lanczos in linear light, widened when the
// scene has more pixels than the headset (supersampling; lobes and widening: ResampleKernel), then stored as vr_copy.comp does.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D scene_tex;
layout(binding = 1, rgba8) uniform writeonly image2D out_img;

layout(push_constant) uniform Constants {
    vec2 size;       // this picture
    vec2 scene_size; // the scene
    vec2 scale;      // scene pixels per pixel of this picture
    vec2 offset;     // the scene position of this picture's left top corner
    float encode;    // 1: the view decodes sRGB: store it encoded again
    float power;
    float contrast;
    float brightness;
    float lobes;     // the Lanczos kernel's lobes (2 or 3)
    float widen;     // how much of the supersampling widens the kernel (1: all of it, a clean downscale; 0: none)
};

vec3 Adjust(vec3 e) {
    e = pow(max(e, vec3(0.0)), vec3(power));
    return clamp((e - 0.5) * contrast + 0.5 + brightness, 0.0, 1.0);
}

const float kPi = 3.14159265;

float Lanczos(float x, float a) {
    x = abs(x);
    if (x < 1e-4) {
        return 1.0;
    }
    if (x >= a) {
        return 0.0;
    }
    const float px = kPi * x;
    return a * sin(px) * sin(px / a) / (px * px);
}

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(size.x) || pixel.y >= int(size.y)) {
        return;
    }
    // where this pixel's centre falls in the scene, in scene pixels
    const vec2 at = offset + (vec2(pixel) + 0.5) * scale;
    // the kernel covers `lobes` of this picture's pixels each side (more scene pixels when the scene is bigger, by
    // `widen` of the supersampling)
    const float a = lobes;
    const vec2 stretch = vec2(1.0) + (max(scale, vec2(1.0)) - vec2(1.0)) * widen;
    const vec2 radius = a * stretch;
    const ivec2 first = ivec2(floor(at - radius + 0.5));
    const ivec2 last = ivec2(floor(at + radius - 0.5));
    const ivec2 top = ivec2(scene_size) - 1;
    vec3 sum = vec3(0.0);
    float total = 0.0;
    for (int y = first.y; y <= last.y; ++y) {
        const float wy = Lanczos((float(y) + 0.5 - at.y) / stretch.y, a);
        if (wy == 0.0) {
            continue;
        }
        for (int x = first.x; x <= last.x; ++x) {
            const float w = wy * Lanczos((float(x) + 0.5 - at.x) / stretch.x, a);
            if (w == 0.0) {
                continue;
            }
            vec3 c = clamp(texelFetch(scene_tex, clamp(ivec2(x, y), ivec2(0), top), 0).rgb, 0.0, 1.0);
            if (encode < 0.5) {
                c = mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(0.04045, c)); // filtered in linear light
            }
            sum += w * c;
            total += w;
        }
    }
    vec3 c = clamp(sum / max(total, 1e-4), 0.0, 1.0);
    c = mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c));
    imageStore(out_img, pixel, vec4(Adjust(c), 1.0));
}
